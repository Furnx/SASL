# Backend Environment Configuration
# Copy this file to .env and fill in your values

# OpenAI API Key for LLM sentence refinement
# Get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Path to the model_P_Line directory (absolute path)
# This is where config.py, data_collection.py, and model/ live
MODEL_P_LINE_PATH=c:/365_days/model_P_Line

# Server settings
HOST=0.0.0.0
PORT=8000
